FROM node:20-slim AS builder
RUN corepack enable
WORKDIR /workspace

# Copy workspace files. pnpm-lock.yaml's importers list is: .,
# apps/bubble-studio, apps/bubblelab-api, docs, packages/*, tools/* —
# apps/ and docs/ copied as a precaution even though this image only
# builds bubble-studio; a direct test showed pnpm tolerates a missing
# workspace member's directory fine, so this isn't confirmed necessary.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages/
COPY apps ./apps/
COPY docs ./docs/
COPY tools ./tools/
COPY .npmrc ./.
# package.json's patchedDependencies needs this file present at install
# time — see Dockerfile.api for the confirmed failure this fixes.
COPY patches ./patches/

# HUSKY=0 + CI=true — husky's "prepare" script throws when .git is missing
# from the build context (it is here); CI=true forces pnpm non-interactive
# for the build-script-approval prompt. See Dockerfile.api for detail.
ENV HUSKY=0
ENV CI=true
# Install all dependencies
RUN pnpm install --frozen-lockfile

ARG VITE_API_URL
ARG VITE_CLERK_PUBLISHABLE_KEY
ARG VITE_DISABLE_AUTH
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_CLERK_PUBLISHABLE_KEY=${VITE_CLERK_PUBLISHABLE_KEY}
ENV VITE_DISABLE_AUTH=${VITE_DISABLE_AUTH}
# Build dependencies
RUN cd packages/bubble-shared-schemas && pnpm run build
RUN cd packages/bubble-core && pnpm run build
RUN cd apps/bubble-studio && pnpm run build

# Runtime stage - use nginx to serve static files directly
FROM nginx:alpine
# Copy static files to nginx html directory
# Note: dist folder contains index.html and assets, so copy its contents
COPY --from=builder /workspace/apps/bubble-studio/dist /usr/share/nginx/html
EXPOSE 80

