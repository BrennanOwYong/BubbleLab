# Stage 1: build the monorepo packages the sidecar depends on (bubble-core),
# using Node + pnpm — same pattern as Dockerfile.api.
FROM node:24-slim AS builder

RUN corepack enable
WORKDIR /workspace

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY .npmrc ./.
# pnpm-lock.yaml's importers list is: ., apps/bubble-studio,
# apps/bubblelab-api, docs, packages/*, tools/* — apps/ and docs/ are
# copied here as a precaution even though this image only runs
# services/builder-agent; a direct test (pnpm install --frozen-lockfile
# with these dirs absent) succeeded anyway, so this isn't a confirmed
# requirement, just cheap insurance. services/builder-agent itself is NOT
# a pnpm workspace member (absent from pnpm-lock.yaml entirely —
# confirmed) and is installed separately below via its own
# package-lock.json — THAT step is the confirmed-necessary one.
COPY apps ./apps/
COPY docs ./docs/
COPY packages ./packages/
COPY tools ./tools/
COPY services ./services/
# package.json's patchedDependencies needs this file present at install
# time — see Dockerfile.api for the confirmed failure this fixes.
COPY patches ./patches/

# HUSKY=0 + CI=true — see Dockerfile.api for why both are needed (husky's
# "prepare" script throws when .git is missing from the build context;
# CI=true forces pnpm non-interactive for the build-script-approval prompt).
ENV HUSKY=0
ENV CI=true
RUN pnpm install --frozen-lockfile

RUN cd packages/bubble-shared-schemas && pnpm run build
RUN cd packages/bubble-core && pnpm run build
RUN cd packages/bubble-runtime && pnpm run build

# services/builder-agent is a standalone npm project (own package-lock.json,
# own real node_modules) — NOT part of the pnpm workspace above, so the
# pnpm install two lines up never touches it. Without this step the image
# builds successfully and then crashes at runtime with "Cannot find module
# 'hono'" (or similar) the moment CMD runs, since services/builder-agent/
# node_modules would otherwise never be populated.
RUN cd services/builder-agent && npm ci

# Stage 2: runtime image. Node >=24 required — the sidecar runs its .ts
# sources directly via Node's native TypeScript support (no build/dist step,
# same as local dev via dev-stack.sh: `node src/index.ts`).
FROM node:24-slim AS runtime

RUN corepack enable
WORKDIR /app

COPY --from=builder /workspace ./

WORKDIR /app/services/builder-agent

EXPOSE 3010
CMD ["node", "src/index.ts"]
